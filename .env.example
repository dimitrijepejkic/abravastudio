# Copy to .env for local overrides. None of these are secrets.

# Which environment the build targets: production | staging | development.
# If unset: Cloudflare builds of the `main` branch are production, every other branch is staging,
# `astro dev` is development, and any other local build is staging (noindex) as a safe default.
PUBLIC_SITE_ENV=

# Cloudflare Web Analytics beacon token (public by design; it is visible in page source).
# Only rendered on production builds. Leave empty to disable analytics.
PUBLIC_CF_ANALYTICS_TOKEN=
