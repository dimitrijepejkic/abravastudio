{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/.well-known/agent-skills/skills-index.schema.json",
  "title": "Agent Skills Discovery Index",
  "type": "object",
  "required": ["$schema", "skills"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "url", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
