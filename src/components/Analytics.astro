---
/** Cloudflare Web Analytics: cookieless, no consent banner needed. Production only. */
import { CF_ANALYTICS_TOKEN, IS_PRODUCTION } from '@/config/site';

const beacon = IS_PRODUCTION && CF_ANALYTICS_TOKEN ? JSON.stringify({ token: CF_ANALYTICS_TOKEN }) : undefined;
---

{beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beacon} />}
