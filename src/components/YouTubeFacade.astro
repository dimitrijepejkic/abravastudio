---
/**
 * Privacy-friendly YouTube embed: shows a self-hosted poster and loads the
 * youtube-nocookie.com player only after the visitor presses play.
 * Without JavaScript the poster is a plain link to the video on YouTube.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Locale } from '@/i18n/locales';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  youtubeId: string;
  title: string;
  poster: ImageMetadata;
}
const { locale, youtubeId, title, poster } = Astro.props;
const t = useTranslations(locale);
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
---

<figure class="video">
  <div class="video__frame" data-youtube={youtubeId} data-youtube-title={title}>
    <a class="video__poster" href={watchUrl} aria-label={t('game.trailer.play', { title })}>
      <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 960px, 100vw" loading="lazy" />
      <span class="video__play" aria-hidden="true"></span>
    </a>
  </div>
  <figcaption class="video__note">{t('game.trailer.note')}</figcaption>
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('[data-youtube]')) {
    const link = frame.querySelector<HTMLAnchorElement>('a');
    link?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.youtube}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.youtubeTitle ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 2px solid var(--c-border);
    overflow: hidden;
  }

  .video__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__poster {
    display: block;
    height: 100%;
  }

  .video__poster:focus-visible {
    outline-offset: -6px;
  }

  .video__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--dur-fast) linear;
  }

  .video__poster:hover img {
    opacity: 1;
  }

  /* Pixel play button */
  .video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 88px;
    height: 64px;
    translate: -50% -50%;
    background: var(--c-hero-red);
    box-shadow:
      0 -4px 0 0 #000,
      0 4px 0 0 #000,
      -4px 0 0 0 #000,
      4px 0 0 0 #000;
  }

  .video__play::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 54%;
    translate: -50% -50%;
    border-style: solid;
    border-width: 14px 0 14px 22px;
    border-color: transparent transparent transparent #fff;
  }

  .video__note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }
</style>
